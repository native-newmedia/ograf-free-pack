{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "pinwheel",
  "version": "1.0.0",
  "name": "Pinwheel",
  "description": "Animated four-colour pinwheel pattern (seamless SVG tile, adapted from a Uiverse.io conic-gradient snippet): the tiled pattern scrolls continuously across the frame at independent X/Y speeds with no tile seams. Full-bleed or contained accent card.",
  "author": {
    "name": "Dunn Lewis"
  },
  "main": "pinwheel.js",
  "supportsRealTime": false,
  "supportsNonRealTime": true,
  "stepCount": 1,
  "v_bmd": {
    "duration": 10
  },
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "colorC1": {
        "type": "string",
        "title": "Colour 1",
        "default": "#ff847c",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "colorC2": {
        "type": "string",
        "title": "Colour 2",
        "default": "#e84a5f",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "colorC3": {
        "type": "string",
        "title": "Colour 3",
        "default": "#fecea8",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "colorC4": {
        "type": "string",
        "title": "Colour 4",
        "default": "#99b898",
        "gddType": "color-rrggbb",
        "pattern": "^#[0-9a-f]{6}$"
      },
      "patternSize": {
        "type": "number",
        "title": "Pattern Tile Size (px)",
        "default": 150,
        "minimum": 30,
        "maximum": 500
      },
      "scrollSpeedX": {
        "type": "number",
        "title": "Scroll Speed X (px/s)",
        "default": 20,
        "minimum": -400,
        "maximum": 400
      },
      "scrollSpeedY": {
        "type": "number",
        "title": "Scroll Speed Y (px/s)",
        "default": 20,
        "minimum": -400,
        "maximum": 400
      },
      "contained": {
        "type": "boolean",
        "title": "Contained Card",
        "default": false
      },
      "cardWidth": {
        "type": "number",
        "title": "Card Width (px)",
        "default": 480,
        "minimum": 60,
        "maximum": 1800
      },
      "cardHeight": {
        "type": "number",
        "title": "Card Height (px)",
        "default": 300,
        "minimum": 60,
        "maximum": 1000
      },
      "cornerRadius": {
        "type": "number",
        "title": "Corner Radius (px)",
        "default": 24,
        "minimum": 0,
        "maximum": 300
      },
      "posX": {
        "type": "number",
        "title": "Position X (px)",
        "default": 0,
        "minimum": -960,
        "maximum": 960
      },
      "posY": {
        "type": "number",
        "title": "Position Y (px)",
        "default": 0,
        "minimum": -540,
        "maximum": 540
      },
      "scale": {
        "type": "number",
        "title": "Scale",
        "default": 1.0,
        "minimum": 0.2,
        "maximum": 3.0
      },
      "opacity": {
        "type": "number",
        "title": "Opacity",
        "default": 1.0,
        "minimum": 0,
        "maximum": 1
      },
      "introDuration": {
        "type": "number",
        "title": "Intro Duration (s)",
        "default": 0,
        "minimum": 0,
        "maximum": 10
      },
      "outroDuration": {
        "type": "number",
        "title": "Outro Duration (s)",
        "default": 0,
        "minimum": 0,
        "maximum": 10
      },
      "easePower": {
        "type": "number",
        "title": "Ease Power",
        "default": 3,
        "minimum": 1,
        "maximum": 6
      }
    }
  },
  "renderRequirements": [
    {
      "frameRate": {
        "ideal": 60
      }
    }
  ],
  "actionDurations": [
    { "type": "playAction", "duration": 0 },
    { "type": "updateAction", "duration": 0 },
    { "type": "stopAction", "duration": 0 }
  ]
}