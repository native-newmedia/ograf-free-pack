				DynParamNum12 = Input { Value = 0.15, },
				DynParamNum13 = Input { Value = 1.2, },
				DynParamNum14 = Input { Value = 0.8, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"lower-third-stagger\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Staggered Lower Third\",\n  \"description\": \"Staggered lower third. Intro runs from the clip's Play action (1.2s), exit from the Stop action (0.8s, auto-placed at clip end). Holds in between, so any clip length works.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"lower-third-stagger.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"name\": {\n        \"type\": \"string\",\n        \"title\": \"Name\",\n        \"default\": \"John Doe\"\n      },\n      \"title\": {\n        \"type\": \"string\",\n        \"title\": \"Title / Role\",\n        \"default\": \"Senior Producer\"\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Accent Colour\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"backgroundColor\": {\n        \"type\": \"string\",\n        \"title\": \"Background Colour\",\n        \"default\": \"#0000009e\",\n        \"gddType\": \"color-rrggbbaa\",\n        \"pattern\": \"^#[0-9a-f]{8}$\"\n      },\n      \"showBackground\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Background\",\n        \"default\": true\n      },\n      \"nameColor\": {\n        \"type\": \"string\",\n        \"title\": \"Name Colour\",\n        \"default\": \"#ffffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"titleColor\": {\n        \"type\": \"string\",\n        \"title\": \"Title Colour\",\n        \"default\": \"#ffffffc7\",\n        \"gddType\": \"color-rrggbbaa\",\n        \"pattern\": \"^#[0-9a-f]{8}$\"\n      },\n      \"barWidth\": {\n        \"type\": \"integer\",\n        \"title\": \"Bar Width (px)\",\n        \"default\": 6,\n        \"minimum\": 2,\n        \"maximum\": 32\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"X Position\",\n        \"default\": 10,\n        \"minimum\": 0,\n        \"maximum\": 100\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Y Position\",\n        \"default\": 90,\n        \"minimum\": 0,\n        \"maximum\": 100\n      },\n       \"scale\": {\n         \"type\": \"number\",\n         \"title\": \"Scale\",\n         \"default\": 1.5,\n         \"minimum\": 0.1,\n         \"maximum\": 2.0\n       },\n         \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      },\n      \"stagger\": {\n        \"type\": \"number\",\n        \"title\": \"Stagger (s)\",\n        \"default\": 0.15,\n        \"minimum\": 0,\n        \"maximum\": 2\n       },\n        \n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 1.2,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n   \n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.8,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      }\n    }\n  },\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 1200\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 800\n    }\n  ],\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ]\n}\n", }
			},
