				DynParamColor0_B = Input { Value = 0.180392156862745, },
				DynParamColor1_G = Input { Value = 0.823529411764706, },
				DynParamColor1_B = Input { Value = 1, },
				DynParamColor2_R = Input { Value = 0.0196078431372549, },
				DynParamColor2_G = Input { Value = 0.0196078431372549, },
				DynParamColor2_B = Input { Value = 0.0627450980392157, },
				DynParamCheck3 = Input { Value = 1, },
				DynParamCheck4 = Input { Value = 1, },
				DynParamNum5 = Input { Value = 1, },
				DynParamNum6 = Input { Value = 40, },
				DynParamNum7 = Input { Value = 1, },
				DynParamNum8 = Input { Value = 5, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"digital-circuit\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Digital Circuit\",\n  \"description\": \"High-tech grid with signal tracers.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"digital-circuit.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": { \"duration\": 60 },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"gridColor\": {\n        \"type\": \"string\",\n        \"title\": \"Grid Color (Dim)\",\n        \"default\": \"#1a1a2eff\",\n        \"gddType\": \"color-rrggbbaa\",\n        \"pattern\": \"^#[0-9a-f]{8}$\"\n      },\n      \"signalColor\": {\n        \"type\": \"string\",\n        \"title\": \"Signal Tracer Color\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"backgroundColor\": {\n        \"type\": \"string\",\n        \"title\": \"Background Fill Color\",\n        \"default\": \"#050510ff\",\n        \"gddType\": \"color-rrggbbaa\",\n        \"pattern\": \"^#[0-9a-f]{8}$\"\n      },\n      \"showBackground\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Background\",\n        \"default\": true\n      },\n      \"showGrid\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Grid\",\n        \"default\": true\n      },\n      \"speed\": {\n        \"type\": \"number\",\n        \"title\": \"Signal Speed\",\n        \"default\": 1.0,\n        \"minimum\": 0.1,\n        \"maximum\": 5.0\n      },\n      \"gridDensity\": {\n        \"type\": \"integer\",\n        \"title\": \"Grid Density\",\n        \"default\": 40,\n        \"minimum\": 10,\n        \"maximum\": 100\n      },\n      \"signalSize\": {\n        \"type\": \"number\",\n        \"title\": \"Signal Tracer Size\",\n        \"default\": 1.0,\n        \"minimum\": 0.2,\n        \"maximum\": 4.0\n      },\n      \"trailLength\": {\n        \"type\": \"integer\",\n        \"title\": \"Signal Trail Length\",\n        \"default\": 5,\n        \"minimum\": 0,\n        \"maximum\": 20\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    { \"type\": \"playAction\", \"duration\": 0 },\n    { \"type\": \"updateAction\", \"duration\": 0 },\n    { \"type\": \"stopAction\", \"duration\": 0 }\n  ]\n}", }
			},
