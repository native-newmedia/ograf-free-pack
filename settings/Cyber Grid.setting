				DynParamNum16 = Input { Value = 3, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"cyber-grid\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Cyber Grid\",\n  \"description\": \"Animated cyberpunk/synthwave grid background (CSS adapted from a Uiverse.io snippet by sunn_2633): two independently-scrolling grid layers over a near-black base. Full-bleed only.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"cyber-grid.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"bgColor\": {\n        \"type\": \"string\",\n        \"title\": \"Base Colour\",\n        \"default\": \"#050505ff\",\n        \"gddType\": \"color-rrggbbaa\",\n        \"pattern\": \"^#[0-9a-f]{8}$\"\n      },\n      \"showBackground\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Base Colour\",\n        \"default\": true\n      },\n      \"gridColorMain\": {\n        \"type\": \"string\",\n        \"title\": \"Main Grid Colour\",\n        \"default\": \"#03ffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"gridColorSub\": {\n        \"type\": \"string\",\n        \"title\": \"Sub Grid Colour\",\n        \"default\": \"#9adcff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"mainOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"Main Grid Opacity\",\n        \"default\": 1,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"subOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"Sub Grid Opacity\",\n        \"default\": 0.513,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"mainCellSize\": {\n        \"type\": \"number\",\n        \"title\": \"Main Cell Size (px)\",\n        \"default\": 138.7,\n        \"minimum\": 10,\n        \"maximum\": 300\n      },\n      \"subCellSize\": {\n        \"type\": \"number\",\n        \"title\": \"Sub Cell Size (px)\",\n        \"default\": 38.3,\n        \"minimum\": 5,\n        \"maximum\": 150\n      },\n      \"mainThickness\": {\n        \"type\": \"number\",\n        \"title\": \"Main Line Thickness (px)\",\n        \"default\": 3,\n        \"minimum\": 0.5,\n        \"maximum\": 10\n      },\n      \"subThickness\": {\n        \"type\": \"number\",\n        \"title\": \"Sub Line Thickness (px)\",\n        \"default\": 2,\n        \"minimum\": 0.5,\n        \"maximum\": 10\n      },\n      \"mainSpeed\": {\n        \"type\": \"number\",\n        \"title\": \"Main Grid Speed (px/s)\",\n        \"default\": 15,\n        \"minimum\": -200,\n        \"maximum\": 200\n      },\n      \"subSpeed\": {\n        \"type\": \"number\",\n        \"title\": \"Sub Grid Speed (px/s)\",\n        \"default\": 10,\n        \"minimum\": -200,\n        \"maximum\": 200\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"Position X (px)\",\n        \"default\": 0,\n        \"minimum\": -960,\n        \"maximum\": 960\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Position Y (px)\",\n        \"default\": 0,\n        \"minimum\": -540,\n        \"maximum\": 540\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power (1 = linear, 3 = cubic)\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    { \"type\": \"playAction\", \"duration\": 0 },\n    { \"type\": \"updateAction\", \"duration\": 0 },\n    { \"type\": \"stopAction\", \"duration\": 0 }\n  ]\n}", }
			},
