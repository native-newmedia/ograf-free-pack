{
	Tools = ordered() {
		Out_Data_Lower_Third = MediaOut {
			Inputs = {
				Index = Input { Value = "0", },
				Input = Input {
					SourceOp = "Merge_Data_Lower_Third",
					Source = "Output",
				}
			},
			ViewInfo = OperatorInfo { Pos = { 220, 33 } },
		},
		Merge_Data_Lower_Third = Merge {
			Inputs = {
				Background = Input {
					SourceOp = "BG_Data_Lower_Third",
					Source = "Output",
				},
				Foreground = Input {
					SourceOp = "OGrafLoader_Data_Lower_Third",
					Source = "Output",
				},
				PerformDepthMerge = Input { Value = 0, }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 33 } },
		},
		OGrafLoader_Data_Lower_Third = OGrafLoader {
			Inputs = {
				Width = Input { Value = 1920, },
				Height = Input { Value = 1080, },
				UseFrameFormatSettings = Input { Value = 1, },
				["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
				TemplatePath = Input { Value = "Templates:Edit/Titles/OGraf-Free/Data Lower Third/Data Lower Third.ograf.json", },
				GlobalOut = Input { Value = 599, },
				TrimOut = Input { Value = 599, },
				StopActionUserModified = Input { Value = 0, },
				["ScheduledAction_0.Name"] = Input { Value = "playAction", },
				["ScheduledAction_1.Name"] = Input { Value = "stopAction", },
				["ScheduledAction_1.Time"] = Input { Value = 575, },
				DynParamText0 = Input { Value = "data/lower-third.jsonc", },
				DynParamCheck2 = Input { Value = 1, },
				DynParamCheck3 = Input { Value = 1, },
				DynParamNum4 = Input { Value = 1, },
				DynParamColor5_G = Input { Value = 0.823529411764706, },
				DynParamColor5_B = Input { Value = 1, },
				DynParamColor6_R = Input { Value = 1, },
				DynParamColor6_G = Input { Value = 1, },
				DynParamColor6_B = Input { Value = 1, },
				DynParamColor7_R = Input { Value = 0.862745098039216, },
				DynParamColor7_G = Input { Value = 0.862745098039216, },
				DynParamColor7_B = Input { Value = 0.862745098039216, },
				DynParamCheck8 = Input { Value = 1, },
				DynParamNum9 = Input { Value = 0.72, },
				DynParamNum10 = Input { Value = 10, },
				DynParamNum11 = Input { Value = 90, },
				DynParamNum12 = Input { Value = 1.5, },
				DynParamNum13 = Input { Value = 0.08, },
				DynParamNum14 = Input { Value = 0.55, },
				DynParamNum15 = Input { Value = 0.4, },
				DynParamNum16 = Input { Value = 3, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"data-driven-lower-third\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Data Lower Third\",\n  \"description\": \"Lower third driven by a local JSON feed. The Data Entry slider jumps straight to any person, the Next and Previous Data Entry actions cycle through entries, Fetch (or the Reload Data checkbox) reloads the data.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"data-driven-lower-third.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"dataFile\": {\n        \"type\": \"string\",\n        \"title\": \"Data File (path)\",\n        \"default\": \"data/lower-third.jsonc\",\n        \"gddType\": \"single-line\"\n      },\n      \"reloadData\": {\n        \"type\": \"boolean\",\n        \"title\": \"Reload Data\",\n        \"default\": false,\n        \"description\": \"Tick or untick this box to make the graphic re-read the data file.\"\n      },\n      \"showSubtitle\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Subtitle\",\n        \"default\": true\n      },\n      \"showCounter\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Entry Counter\",\n        \"default\": true\n      },\n      \"dataIndex\": {\n        \"type\": \"integer\",\n        \"title\": \"Data Entry\",\n        \"description\": \"Person to show from data/lower-third.json (matches the number in the corner counter). Maximum should equal the record count in the JSON file; raise it if you add people.\",\n        \"default\": 1,\n        \"minimum\": 1,\n        \"maximum\": 6\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Accent Colour\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"nameColor\": {\n        \"type\": \"string\",\n        \"title\": \"Name Colour\",\n        \"default\": \"#ffffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"titleColor\": {\n        \"type\": \"string\",\n        \"title\": \"Title Colour\",\n        \"default\": \"#dcdcdc\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"showAccentBar\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Accent Bar\",\n        \"default\": true\n      },\n      \"bgOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"BG Opacity\",\n        \"default\": 0.72,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"X Position\",\n        \"default\": 10,\n        \"minimum\": 0,\n        \"maximum\": 100\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Y Position\",\n        \"default\": 90,\n        \"minimum\": 0,\n        \"maximum\": 100\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.5,\n        \"minimum\": 0.1,\n        \"maximum\": 2.0\n      },\n      \"stagger\": {\n        \"type\": \"number\",\n        \"title\": \"Stagger (s)\",\n        \"default\": 0.08,\n        \"minimum\": 0,\n        \"maximum\": 0.5\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0.55,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.4,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      }\n    }\n  },\n  \"customActions\": [\n    {\n      \"id\": \"fetch\",\n      \"name\": \"Fetch JSON\"\n    },\n    {\n      \"id\": \"prev\",\n      \"name\": \"Previous Data Entry\"\n    },\n    {\n      \"id\": \"next\",\n      \"name\": \"Next Data Entry\"\n    }\n  ],\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 550\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 400\n    }\n  ]\n}\n", }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 0 } },
			UserControls = ordered() { JSONLink = { LINK_Main = 3, LINKID_DataType = "Text", INP_Default = 0, IC_ControlPage = -1, INPID_InputControl = "ImageControl", LINKS_Name = "JSON Link", } },
			Version = 1
		},
		BG_Data_Lower_Third = Background {
			Inputs = {
				GlobalOut = Input { Value = 601, },
				Width = Input { Value = 1920, },
				Height = Input { Value = 1080, },
				UseFrameFormatSettings = Input { Value = 1, },
				["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, }
			},
			ViewInfo = OperatorInfo { Pos = { 0, 33 } },
		}
	}
}
