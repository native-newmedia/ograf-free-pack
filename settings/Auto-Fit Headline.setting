{
	Tools = ordered() {
		Out_Auto_Fit_Headline = MediaOut {
			Inputs = {
				Index = Input { Value = "0", },
				Input = Input {
					SourceOp = "Merge_Auto_Fit_Headline",
					Source = "Output",
				}
			},
			ViewInfo = OperatorInfo { Pos = { 220, 33 } },
		},
		Merge_Auto_Fit_Headline = Merge {
			Inputs = {
				Background = Input {
					SourceOp = "BG_Auto_Fit_Headline",
					Source = "Output",
				},
