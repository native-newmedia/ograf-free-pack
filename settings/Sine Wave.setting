				DynParamNum7 = Input { Value = 80, },
				DynParamNum8 = Input { Value = 2, },
				JSONLink = Input { Value = "{\n    \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n    \"id\": \"sine-wave-lines\",\n    \"version\": \"1.0.0\",\n    \"name\": \"Sine Wave\",\n    \"description\": \"Multiple layered sine waves drifting across the screen with organic interference patterns. Fully configurable colours, speed, amplitude and line count.\",\n    \"author\": {\n        \"name\": \"Dunn Lewis\"\n    },\n    \"main\": \"sine-wave-lines.js\",\n    \"supportsRealTime\": false,\n    \"supportsNonRealTime\": true,\n    \"stepCount\": 1,\n    \"v_bmd\": { \"duration\": 60 },\n    \"schema\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"properties\": {\n            \"backgroundColor\": {\n                \"type\": \"string\",\n                \"title\": \"Background Color\",\n                \"default\": \"#020818ff\",\n                \"gddType\": \"color-rrggbbaa\",\n                \"pattern\": \"^#[0-9a-f]{8}$\"\n            },\n            \"showBackground\": {\n                \"type\": \"boolean\",\n                \"title\": \"Show Background\",\n                \"default\": true\n            },\n            \"waveColor1\": {\n                \"type\": \"string\",\n                \"title\": \"Wave Color 1\",\n                \"default\": \"#00d2ff\",\n                \"gddType\": \"color-rrggbb\",\n                \"pattern\": \"^#[0-9a-f]{6}$\"\n            },\n            \"waveColor2\": {\n                \"type\": \"string\",\n                \"title\": \"Wave Color 2\",\n                \"default\": \"#7b2fff\",\n                \"gddType\": \"color-rrggbb\",\n                \"pattern\": \"^#[0-9a-f]{6}$\"\n            },\n            \"waveColor3\": {\n                \"type\": \"string\",\n                \"title\": \"Wave Color 3\",\n                \"default\": \"#ff2fd6\",\n                \"gddType\": \"color-rrggbb\",\n                \"pattern\": \"^#[0-9a-f]{6}$\"\n            },\n            \"waveCount\": {\n                \"type\": \"integer\",\n                \"title\": \"Wave Count\",\n                \"default\": 6,\n                \"minimum\": 1,\n                \"maximum\": 24\n            },\n            \"speed\": {\n                \"type\": \"number\",\n                \"title\": \"Speed\",\n                \"default\": 1.0,\n                \"minimum\": 0.0,\n                \"maximum\": 5.0\n            },\n            \"amplitude\": {\n                \"type\": \"number\",\n                \"title\": \"Amplitude (px)\",\n                \"default\": 80,\n                \"minimum\": 10,\n                \"maximum\": 400\n            },\n            \"lineWidth\": {\n                \"type\": \"number\",\n                \"title\": \"Line Width (px)\",\n                \"default\": 2.0,\n                \"minimum\": 0.5,\n                \"maximum\": 12.0\n            },\n            \"blur\": {\n                \"type\": \"number\",\n                \"title\": \"Glow Blur (px)\",\n                \"default\": 0,\n                \"minimum\": 0,\n                \"maximum\": 20\n            },\n            \"introDuration\": {\n                \"type\": \"number\",\n                \"title\": \"Intro Duration (s)\",\n                \"default\": 0,\n                \"minimum\": 0,\n                \"maximum\": 10\n            },\n            \"outroDuration\": {\n                \"type\": \"number\",\n                \"title\": \"Outro Duration (s)\",\n                \"default\": 0,\n                \"minimum\": 0,\n                \"maximum\": 10\n            }\n\n        }\n    },\n    \"renderRequirements\": [\n        {\n            \"resolution\": {\n                \"width\": {\n                    \"ideal\": 1920\n                },\n                \"height\": {\n                    \"ideal\": 1080\n                }\n            },\n            \"frameRate\": {\n                \"ideal\": 60\n            }\n        }\n    ],\n    \"actionDurations\": [\n        { \"type\": \"playAction\", \"duration\": 0 },\n        { \"type\": \"updateAction\", \"duration\": 0 },\n        { \"type\": \"stopAction\", \"duration\": 0 }\n    ],\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ]\n}\n", }
