				DynParamNum14 = Input { Value = 0.6, },
				DynParamNum15 = Input { Value = 0.4, },
				DynParamNum16 = Input { Value = 3, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"json-lower-third\",\n  \"version\": \"1.0.0\",\n  \"name\": \"JSON Lower Third\",\n  \"description\": \"Name + title loaded from data/data.txt on disk. The file holds JSON but uses a .txt extension so Resolve does not list it as a title. Edit it, or point Data File at your own file.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"json-lower-third.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"dataFile\": {\n        \"type\": \"string\",\n        \"title\": \"Data File (path)\",\n        \"default\": \"data/data.jsonc\",\n        \"gddType\": \"single-line\"\n      },\n      \"reloadData\": {\n        \"type\": \"boolean\",\n        \"title\": \"Reload Data (toggle to re-read)\",\n        \"default\": false,\n        \"description\": \"Tick or untick this box to make the graphic re-read the data file.\"\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Accent Colour\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"nameColor\": {\n        \"type\": \"string\",\n        \"title\": \"Name Colour\",\n        \"default\": \"#ffffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"titleColor\": {\n        \"type\": \"string\",\n        \"title\": \"Title Colour\",\n        \"default\": \"#c9c9c9\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"locationColor\": {\n        \"type\": \"string\",\n        \"title\": \"Location Colour\",\n        \"default\": \"#ffffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"liveBugColor\": {\n        \"type\": \"string\",\n        \"title\": \"Live Bug Text Colour\",\n        \"default\": \"#ffffff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"liveBugBgColor\": {\n        \"type\": \"string\",\n        \"title\": \"Live Bug Background Colour\",\n        \"default\": \"#e53030\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"locationOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"Location Opacity\",\n        \"default\": 0.45,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"showLocation\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Location\",\n        \"default\": true\n      },\n      \"showAccentBar\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Accent Bar\",\n        \"default\": true\n      },\n      \"showLiveBug\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Live Bug\",\n        \"default\": true\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.5,\n        \"minimum\": 0.1,\n        \"maximum\": 2.0\n      },\n      \"stagger\": {\n        \"type\": \"number\",\n        \"title\": \"Stagger (s)\",\n        \"default\": 0.12,\n        \"minimum\": 0,\n        \"maximum\": 1.0\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0.6,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.4,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power (1 = linear, 3 = cubic)\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 600\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 400\n    }\n  ]\n}\n", }
			},
