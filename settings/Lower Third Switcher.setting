						} }, },
				["ScheduledAction_4.Time"] = Input { Value = 90, },
				["ScheduledAction_5.Name"] = Input { Value = "customAction", },
				["ScheduledAction_5.Value"] = Input { Value = ScriptVal { {
							name = "Switch to A",
							id = "a",
							payload = {
							}
						} }, },
				["ScheduledAction_5.Time"] = Input { Value = 110, },
				DynParamNum0 = Input { Value = 1, },
				DynParamText1 = Input { Value = "Sarah Johnson", },
				DynParamText2 = Input { Value = "CEO, Acme Corp", },
				DynParamText3 = Input { Value = "London", },
				DynParamText4 = Input { Value = "James Chen", },
				DynParamText5 = Input { Value = "CTO, Acme Corp", },
				DynParamText6 = Input { Value = "New York", },
				DynParamColor7_G = Input { Value = 0.823529411764706, },
				DynParamColor7_B = Input { Value = 1, },
				DynParamNum8 = Input { Value = 0.88, },
				DynParamNum9 = Input { Value = 1.5, },
				DynParamNum10 = Input { Value = 0.15, },
				DynParamNum11 = Input { Value = 3, },
				DynParamNum12 = Input { Value = 0.5, },
				DynParamNum13 = Input { Value = 0.4, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"ab-switcher\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Lower Third Switcher\",\n  \"description\": \"Two lower-third layouts in one graphic. Toggle instantly between Layout A and Layout B. currentLayout field is NRT-safe.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"ab-switcher.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"currentLayout\": {\n          \"type\": \"number\",\n          \"title\": \"Active Layout (1 Layout A, 2 Layout B)\",\n          \"default\": 1,\n          \"minimum\": 1,\n          \"maximum\": 2\n      },\n      \"nameA\": {\n        \"type\": \"string\",\n        \"title\": \"Name A\",\n        \"default\": \"Sarah Johnson\"\n      },\n      \"titleA\": {\n        \"type\": \"string\",\n        \"title\": \"Title A\",\n        \"default\": \"CEO, Acme Corp\"\n      },\n      \"subtitleA\": {\n        \"type\": \"string\",\n        \"title\": \"Subtitle A\",\n        \"default\": \"London\"\n      },\n      \"nameB\": {\n        \"type\": \"string\",\n        \"title\": \"Name B\",\n        \"default\": \"James Chen\"\n      },\n      \"titleB\": {\n        \"type\": \"string\",\n        \"title\": \"Title B\",\n        \"default\": \"CTO, Acme Corp\"\n      },\n      \"subtitleB\": {\n        \"type\": \"string\",\n        \"title\": \"Subtitle B\",\n        \"default\": \"New York\"\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Accent Colour\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"bgOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"Background Opacity\",\n        \"default\": 0.88,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.5,\n        \"minimum\": 0.1,\n        \"maximum\": 2.0\n      },\n      \"stagger\": {\n        \"type\": \"number\",\n        \"title\": \"Stagger (s)\",\n        \"default\": 0.15,\n        \"minimum\": 0,\n        \"maximum\": 2\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power (1 = linear, 3 = cubic)\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0.5,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.4,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      }\n    }\n  },\n  \"customActions\": [\n    {\n      \"id\": \"a\",\n      \"name\": \"Switch to A\"\n    },\n    {\n      \"id\": \"b\",\n      \"name\": \"Switch to B\"\n    },\n    {\n      \"id\": \"toggle\",\n      \"name\": \"Toggle A/B\"\n    }\n  ],\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 500\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 400\n    }\n  ]\n}\n", }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 0 } },
			UserControls = ordered() { JSONLink = { LINK_Main = 3, LINKID_DataType = "Text", INP_Default = 0, IC_ControlPage = -1, INPID_InputControl = "ImageControl", LINKS_Name = "JSON Link", } },
			Version = 1
		},
		BG_ab_switcher = Background {
