		},
		Merge_Lower_Third_Switcher = Merge {
			Inputs = {
				Background = Input {
					SourceOp = "BG_Lower_Third_Switcher",
					Source = "Output",
				},
				Foreground = Input {
					SourceOp = "OGrafLoader_Lower_Third_Switcher",
					Source = "Output",
				},
				PerformDepthMerge = Input { Value = 0, }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 33 } },
		},
		OGrafLoader_Lower_Third_Switcher = OGrafLoader {
			Inputs = {
				Width = Input { Value = 1920, },
				Height = Input { Value = 1080, },
				UseFrameFormatSettings = Input { Value = 1, },
				["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
				TemplatePath = Input { Value = "Templates:Edit/Titles/OGraf-Free/Lower Third Switcher/Lower Third Switcher.ograf.json", },
				GlobalOut = Input { Value = 599, },
				TrimOut = Input { Value = 599, },
				StopActionUserModified = Input { Value = 0, },
				["ScheduledAction_0.Name"] = Input { Value = "playAction", },
				["ScheduledAction_1.Name"] = Input { Value = "stopAction", },
				["ScheduledAction_1.Time"] = Input { Value = 575, },
				DynParamNum0 = Input { Value = 1, },
				DynParamCombo0 = Input { Value = FuID { "1" }, },
				DynParamText1 = Input { Value = "Sarah Johnson", },
				DynParamText2 = Input { Value = "CEO, Acme Corp", },
				DynParamText3 = Input { Value = "London", },
				DynParamText4 = Input { Value = "James Chen", },
				DynParamText5 = Input { Value = "CTO, Acme Corp", },
				DynParamText6 = Input { Value = "New York", },
				DynParamColor7_G = Input { Value = 0.823529411764706, },
				DynParamColor7_B = Input { Value = 1, },
				DynParamNum8 = Input { Value = 0.88, },
				DynParamNum9 = Input { Value = 2, },
				DynParamNum10 = Input { Value = 0.15, },
				DynParamNum11 = Input { Value = 3, },
				DynParamNum12 = Input { Value = 0.5, },
				DynParamNum13 = Input { Value = 0.4, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"ab-switcher\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Lower Third Switcher\",\n  \"description\": \"Two lower-third layouts in one graphic. Toggle instantly between Layout A and Layout B.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"ab-switcher.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"currentLayout\": {\n        \"type\": \"integer\",\n        \"title\": \"Active Layout\",\n        \"default\": 1,\n        \"minimum\": 1,\n        \"maximum\": 2,\n        \"enum\": [\n          1,\n          2\n        ],\n        \"gddType\": \"select\",\n        \"gddOptions\": {\n          \"labels\": {\n            \"1\": \"Layout A\",\n            \"2\": \"Layout B\"\n          }\n        }\n      },\n      \"nameA\": {\n        \"type\": \"string\",\n        \"title\": \"Layout A: Name\",\n        \"default\": \"Sarah Johnson\"\n      },\n      \"titleA\": {\n        \"type\": \"string\",\n        \"title\": \"Layout A: Title\",\n        \"default\": \"CEO, Acme Corp\"\n      },\n      \"subtitleA\": {\n        \"type\": \"string\",\n        \"title\": \"Layout A: Subtitle\",\n        \"default\": \"London\"\n      },\n      \"nameB\": {\n        \"type\": \"string\",\n        \"title\": \"Layout B: Name\",\n        \"default\": \"James Chen\"\n      },\n      \"titleB\": {\n        \"type\": \"string\",\n        \"title\": \"Layout B: Title\",\n        \"default\": \"CTO, Acme Corp\"\n      },\n      \"subtitleB\": {\n        \"type\": \"string\",\n        \"title\": \"Layout B: Subtitle\",\n        \"default\": \"New York\"\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Accent Colour\",\n        \"default\": \"#00d2ff\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"bgOpacity\": {\n        \"type\": \"number\",\n        \"title\": \"Background Opacity\",\n        \"default\": 0.88,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 2.0,\n        \"minimum\": 0.1,\n        \"maximum\": 3.0\n      },\n      \"stagger\": {\n        \"type\": \"number\",\n        \"title\": \"Stagger (s)\",\n        \"default\": 0.15,\n        \"minimum\": 0,\n        \"maximum\": 2\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0.5,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.4,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      }\n    }\n  },\n  \"customActions\": [\n    {\n      \"id\": \"a\",\n      \"name\": \"Switch to Layout A\"\n    },\n    {\n      \"id\": \"b\",\n      \"name\": \"Switch to Layout B\"\n    },\n    {\n      \"id\": \"toggle\",\n      \"name\": \"Toggle Layout A/B\"\n    }\n  ],\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 500\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 400\n    }\n  ]\n}\n", }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 0 } },
			UserControls = ordered() { JSONLink = { LINK_Main = 3, LINKID_DataType = "Text", INP_Default = 0, IC_ControlPage = -1, INPID_InputControl = "ImageControl", LINKS_Name = "JSON Link", } },
			Version = 1
		},
		BG_Lower_Third_Switcher = Background {
			Inputs = {
