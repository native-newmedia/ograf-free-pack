						} }, },
				["ScheduledAction_2.Time"] = Input { Value = 50, },
				["ScheduledAction_3.Name"] = Input { Value = "customAction", },
				["ScheduledAction_3.Value"] = Input { Value = ScriptVal { {
							name = "Switch to A",
							id = "a",
							payload = {
							}
						} }, },
				["ScheduledAction_3.Time"] = Input { Value = 70, },
				["ScheduledAction_4.Name"] = Input { Value = "customAction", },
				["ScheduledAction_4.Value"] = Input { Value = ScriptVal { {
							name = "Switch to B",
							id = "b",
							payload = {
