				DynParamNum18 = Input { Value = 0.7, },
				DynParamNum19 = Input { Value = 3, },
				DynParamNum20 = Input { Value = 0.5, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"neumorphic-pulse\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Neumorphic Pulse\",\n  \"description\": \"Soft-UI neumorphic panel that raises in, periodically presses in and releases, then raises back out.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"neumorphic-pulse.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"label\": {\n        \"type\": \"string\",\n        \"title\": \"Label\",\n        \"gddType\": \"single-line\",\n        \"default\": \"Confirm\"\n      },\n      \"bgColor\": {\n        \"type\": \"string\",\n        \"title\": \"Panel Colour\",\n        \"default\": \"#e0e5ec\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"accentColor\": {\n        \"type\": \"string\",\n        \"title\": \"Icon / Label Colour\",\n        \"default\": \"#000000\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"shape\": {\n        \"type\": \"integer\",\n        \"title\": \"Shape\",\n        \"default\": 1,\n        \"minimum\": 1,\n        \"maximum\": 3,\n        \"enum\": [1, 2, 3],\n        \"gddType\": \"select\",\n        \"gddOptions\": {\n          \"labels\": {\n            \"1\": \"Rounded Square\",\n            \"2\": \"Circle\",\n            \"3\": \"Pill\"\n          }\n        }\n      },\n      \"neuShape\": {\n        \"type\": \"integer\",\n        \"title\": \"Neumorphic Shape\",\n        \"default\": 1,\n        \"minimum\": 1,\n        \"maximum\": 4,\n        \"enum\": [1, 2, 3, 4],\n        \"gddType\": \"select\",\n        \"gddOptions\": {\n          \"labels\": {\n            \"1\": \"Flat\",\n            \"2\": \"Concave\",\n            \"3\": \"Convex\",\n            \"4\": \"Pressed\"\n          }\n        }\n      },\n      \"lightSource\": {\n        \"type\": \"integer\",\n        \"title\": \"Light Source\",\n        \"default\": 1,\n        \"minimum\": 1,\n        \"maximum\": 4,\n        \"enum\": [1, 2, 3, 4],\n        \"gddType\": \"select\",\n        \"gddOptions\": {\n          \"labels\": {\n            \"1\": \"Top-Left\",\n            \"2\": \"Top-Right\",\n            \"3\": \"Bottom-Right\",\n            \"4\": \"Bottom-Left\"\n          }\n        }\n      },\n      \"size\": {\n        \"type\": \"number\",\n        \"title\": \"Size (px)\",\n        \"default\": 409.4,\n        \"minimum\": 60,\n        \"maximum\": 600\n      },\n      \"cornerRadius\": {\n        \"type\": \"number\",\n        \"title\": \"Corner Radius (px)\",\n        \"default\": 33.7,\n        \"minimum\": 0,\n        \"maximum\": 300\n      },\n      \"shadowDistance\": {\n        \"type\": \"number\",\n        \"title\": \"Shadow Distance (px)\",\n        \"default\": 26.46,\n        \"minimum\": 4,\n        \"maximum\": 60\n      },\n      \"pressDepth\": {\n        \"type\": \"number\",\n        \"title\": \"Shadow Contrast\",\n        \"default\": 0.7,\n        \"minimum\": 0.1,\n        \"maximum\": 1.0\n      },\n      \"iconType\": {\n        \"type\": \"integer\",\n        \"title\": \"Icon\",\n        \"default\": 2,\n        \"minimum\": 1,\n        \"maximum\": 6,\n        \"enum\": [1, 2, 3, 4, 5, 6],\n        \"gddType\": \"select\",\n        \"gddOptions\": {\n          \"labels\": {\n            \"1\": \"None\",\n            \"2\": \"Check\",\n            \"3\": \"Heart\",\n            \"4\": \"Power\",\n            \"5\": \"Lock\",\n            \"6\": \"Star\"\n          }\n        }\n      },\n      \"showLabel\": {\n        \"type\": \"boolean\",\n        \"title\": \"Show Label\",\n        \"default\": true\n      },\n      \"pulseEnabled\": {\n        \"type\": \"boolean\",\n        \"title\": \"Auto Press/Release\",\n        \"default\": true\n      },\n      \"pulseInterval\": {\n        \"type\": \"number\",\n        \"title\": \"Pulse Interval (s)\",\n        \"default\": 2.2,\n        \"minimum\": 0.3,\n        \"maximum\": 20\n      },\n      \"pulseDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Press Duration (s)\",\n        \"default\": 0.6,\n        \"minimum\": 0.1,\n        \"maximum\": 10\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"Position X (px)\",\n        \"default\": 0,\n        \"minimum\": -960,\n        \"maximum\": 960\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Position Y (px)\",\n        \"default\": 0,\n        \"minimum\": -540,\n        \"maximum\": 540\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.0,\n        \"minimum\": 0.1,\n        \"maximum\": 3.0\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0.7,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n       \"easePower\": {\n         \"type\": \"number\",\n         \"title\": \"Ease Power\",\n         \"default\": 3,\n         \"minimum\": 1,\n         \"maximum\": 6\n       },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0.5,\n        \"minimum\": 0.2,\n        \"maximum\": 10\n      },\n\n      \"bridgeJson\": {\n        \"type\": \"string\",\n        \"title\": \"Bridge JSON\",\n        \"description\": \"Values of every property after this one, as JSON. OGrafLoader shows only 20 properties, so vOGrafManifestUI writes the rest here. Leave empty to use the defaults.\",\n        \"default\": \"\"\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    {\n      \"type\": \"playAction\",\n      \"duration\": 700\n    },\n    {\n      \"type\": \"updateAction\",\n      \"duration\": 0\n    },\n    {\n      \"type\": \"stopAction\",\n      \"duration\": 500\n    }\n  ]\n}", }
			},
