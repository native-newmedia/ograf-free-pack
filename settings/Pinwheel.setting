				DynParamNum17 = Input { Value = 3, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"pinwheel\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Pinwheel\",\n  \"description\": \"Animated four-colour pinwheel pattern (seamless SVG tile, adapted from a Uiverse.io conic-gradient snippet): the tiled pattern scrolls continuously across the frame at independent X/Y speeds with no tile seams. Full-bleed or contained accent card.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"pinwheel.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"colorC1\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 1\",\n        \"default\": \"#ff847c\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"colorC2\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 2\",\n        \"default\": \"#e84a5f\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"colorC3\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 3\",\n        \"default\": \"#fecea8\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"colorC4\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 4\",\n        \"default\": \"#99b898\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"patternSize\": {\n        \"type\": \"number\",\n        \"title\": \"Pattern Tile Size (px)\",\n        \"default\": 150,\n        \"minimum\": 30,\n        \"maximum\": 500\n      },\n      \"scrollSpeedX\": {\n        \"type\": \"number\",\n        \"title\": \"Scroll Speed X (px/s)\",\n        \"default\": 20,\n        \"minimum\": -400,\n        \"maximum\": 400\n      },\n      \"scrollSpeedY\": {\n        \"type\": \"number\",\n        \"title\": \"Scroll Speed Y (px/s)\",\n        \"default\": 20,\n        \"minimum\": -400,\n        \"maximum\": 400\n      },\n      \"contained\": {\n        \"type\": \"boolean\",\n        \"title\": \"Contained Card\",\n        \"default\": false\n      },\n      \"cardWidth\": {\n        \"type\": \"number\",\n        \"title\": \"Card Width (px)\",\n        \"default\": 480,\n        \"minimum\": 60,\n        \"maximum\": 1800\n      },\n      \"cardHeight\": {\n        \"type\": \"number\",\n        \"title\": \"Card Height (px)\",\n        \"default\": 300,\n        \"minimum\": 60,\n        \"maximum\": 1000\n      },\n      \"cornerRadius\": {\n        \"type\": \"number\",\n        \"title\": \"Corner Radius (px)\",\n        \"default\": 24,\n        \"minimum\": 0,\n        \"maximum\": 300\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"Position X (px)\",\n        \"default\": 0,\n        \"minimum\": -960,\n        \"maximum\": 960\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Position Y (px)\",\n        \"default\": 0,\n        \"minimum\": -540,\n        \"maximum\": 540\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.0,\n        \"minimum\": 0.2,\n        \"maximum\": 3.0\n      },\n      \"opacity\": {\n        \"type\": \"number\",\n        \"title\": \"Opacity\",\n        \"default\": 1.0,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    { \"type\": \"playAction\", \"duration\": 0 },\n    { \"type\": \"updateAction\", \"duration\": 0 },\n    { \"type\": \"stopAction\", \"duration\": 0 }\n  ]\n}", }
