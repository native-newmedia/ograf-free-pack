{
	Tools = ordered() {
		Out_Dot_Lattice = MediaOut {
			Inputs = {
				Index = Input { Value = "0", },
				Input = Input {
					SourceOp = "Merge_Dot_Lattice",
					Source = "Output",
				}
			},
			ViewInfo = OperatorInfo { Pos = { 220, 33 } },
		},
		Merge_Dot_Lattice = Merge {
			Inputs = {
				Background = Input {
					SourceOp = "BG_Dot_Lattice",
					Source = "Output",
				},
				Foreground = Input {
					SourceOp = "OGrafLoader_Dot_Lattice",
					Source = "Output",
				},
				PerformDepthMerge = Input { Value = 0, }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 33 } },
		},
		OGrafLoader_Dot_Lattice = OGrafLoader {
			Inputs = {
				Width = Input { Value = 1920, },
				Height = Input { Value = 1080, },
				UseFrameFormatSettings = Input { Value = 1, },
				["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, },
				TemplatePath = Input { Value = "Templates:Edit/OGraf-Free/Dot Lattice/Dot Lattice.ograf.json", },
				GlobalOut = Input { Value = 599, },
				TrimOut = Input { Value = 599, },
				StopActionUserModified = Input { Value = 0, },
				["ScheduledAction_0.Name"] = Input { Value = "playAction", },
				["ScheduledAction_1.Name"] = Input { Value = "stopAction", },
				["ScheduledAction_1.Time"] = Input { Value = 599, },
				DynParamColor0_R = Input { Value = 0.968627450980392, },
				DynParamColor0_G = Input { Value = 0.823529411764706, },
				DynParamColor0_B = Input { Value = 0.631372549019608, },
				DynParamColor1_R = Input { Value = 0.0196078431372549, },
				DynParamColor1_G = Input { Value = 0.0196078431372549, },
				DynParamColor1_B = Input { Value = 0.494117647058824, },
				DynParamNum2 = Input { Value = 150, },
				DynParamCheck3 = Input { Value = 1, },
				DynParamNum4 = Input { Value = 20, },
				DynParamNum5 = Input { Value = 20, },
				DynParamNum8 = Input { Value = 480, },
				DynParamNum9 = Input { Value = 300, },
				DynParamNum10 = Input { Value = 24, },
				DynParamNum13 = Input { Value = 1, },
				DynParamNum14 = Input { Value = 1, },
				DynParamNum17 = Input { Value = 3, },
				JSONLink = Input { Value = "{\n  \"$schema\": \"https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json\",\n  \"id\": \"dot-lattice\",\n  \"version\": \"1.0.0\",\n  \"name\": \"Dot Lattice\",\n  \"description\": \"Animated dot-lattice background pattern (CSS adapted from a Uiverse.io snippet by csemszepp): interlocking corner and centre dot rings that can scroll, rotate, and be used full-bleed or as a contained accent card.\",\n  \"author\": {\n    \"name\": \"Dunn Lewis\"\n  },\n  \"main\": \"dot-lattice.js\",\n  \"supportsRealTime\": false,\n  \"supportsNonRealTime\": true,\n  \"stepCount\": 1,\n  \"v_bmd\": {\n    \"duration\": 10\n  },\n  \"schema\": {\n    \"type\": \"object\",\n    \"additionalProperties\": false,\n    \"properties\": {\n      \"colorPrimary\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 1\",\n        \"default\": \"#f7d2a1\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"colorSecondary\": {\n        \"type\": \"string\",\n        \"title\": \"Colour 2\",\n        \"default\": \"#05057e\",\n        \"gddType\": \"color-rrggbb\",\n        \"pattern\": \"^#[0-9a-f]{6}$\"\n      },\n      \"patternSize\": {\n        \"type\": \"number\",\n        \"title\": \"Pattern Tile Size (px)\",\n        \"default\": 150,\n        \"minimum\": 30,\n        \"maximum\": 500\n      },\n      \"scrollEnabled\": {\n        \"type\": \"boolean\",\n        \"title\": \"Animate Scroll\",\n        \"default\": true\n      },\n      \"scrollSpeedX\": {\n        \"type\": \"number\",\n        \"title\": \"Scroll Speed X (px/s)\",\n        \"default\": 20,\n        \"minimum\": -400,\n        \"maximum\": 400\n      },\n      \"scrollSpeedY\": {\n        \"type\": \"number\",\n        \"title\": \"Scroll Speed Y (px/s)\",\n        \"default\": 20,\n        \"minimum\": -400,\n        \"maximum\": 400\n      },\n      \"rotation\": {\n        \"type\": \"number\",\n        \"title\": \"Rotation (deg)\",\n        \"default\": 0,\n        \"minimum\": -180,\n        \"maximum\": 180\n      },\n      \"contained\": {\n        \"type\": \"boolean\",\n        \"title\": \"Contained Card\",\n        \"default\": false\n      },\n      \"cardWidth\": {\n        \"type\": \"number\",\n        \"title\": \"Card Width (px)\",\n        \"default\": 480,\n        \"minimum\": 60,\n        \"maximum\": 1800\n      },\n      \"cardHeight\": {\n        \"type\": \"number\",\n        \"title\": \"Card Height (px)\",\n        \"default\": 300,\n        \"minimum\": 60,\n        \"maximum\": 1000\n      },\n      \"cornerRadius\": {\n        \"type\": \"number\",\n        \"title\": \"Corner Radius (px)\",\n        \"default\": 24,\n        \"minimum\": 0,\n        \"maximum\": 300\n      },\n      \"posX\": {\n        \"type\": \"number\",\n        \"title\": \"Position X (px)\",\n        \"default\": 0,\n        \"minimum\": -960,\n        \"maximum\": 960\n      },\n      \"posY\": {\n        \"type\": \"number\",\n        \"title\": \"Position Y (px)\",\n        \"default\": 0,\n        \"minimum\": -540,\n        \"maximum\": 540\n      },\n      \"scale\": {\n        \"type\": \"number\",\n        \"title\": \"Scale\",\n        \"default\": 1.0,\n        \"minimum\": 0.2,\n        \"maximum\": 3.0\n      },\n      \"opacity\": {\n        \"type\": \"number\",\n        \"title\": \"Opacity\",\n        \"default\": 1.0,\n        \"minimum\": 0,\n        \"maximum\": 1\n      },\n      \"introDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Intro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"outroDuration\": {\n        \"type\": \"number\",\n        \"title\": \"Outro Duration (s)\",\n        \"default\": 0,\n        \"minimum\": 0,\n        \"maximum\": 10\n      },\n      \"easePower\": {\n        \"type\": \"number\",\n        \"title\": \"Ease Power\",\n        \"default\": 3,\n        \"minimum\": 1,\n        \"maximum\": 6\n      }\n    }\n  },\n  \"renderRequirements\": [\n    {\n      \"frameRate\": {\n        \"ideal\": 60\n      }\n    }\n  ],\n  \"actionDurations\": [\n    { \"type\": \"playAction\", \"duration\": 0 },\n    { \"type\": \"updateAction\", \"duration\": 0 },\n    { \"type\": \"stopAction\", \"duration\": 0 }\n  ]\n}", }
			},
			ViewInfo = OperatorInfo { Pos = { 110, 0 } },
			UserControls = ordered() { JSONLink = { LINK_Main = 3, LINKID_DataType = "Text", INP_Default = 0, IC_ControlPage = -1, INPID_InputControl = "ImageControl", LINKS_Name = "JSON Link", } },
			Version = 1
		},
		BG_Dot_Lattice = Background {
			Inputs = {
				GlobalOut = Input { Value = 601, },
				Width = Input { Value = 1920, },
				Height = Input { Value = 1080, },
				UseFrameFormatSettings = Input { Value = 1, },
				["Gamut.SLogVersion"] = Input { Value = FuID { "SLog2" }, }
			},
			ViewInfo = OperatorInfo { Pos = { 0, 33 } },
		}
